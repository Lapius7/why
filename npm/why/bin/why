#!/usr/bin/env node
// OS/CPU 別パッケージのネイティブバイナリを起動するシム。
// postinstall が動けばこのファイル自体がネイティブバイナリに置き換わるので、
// ここを通るのは --ignore-scripts でインストールされた場合だけ。
'use strict';
const { spawnSync } = require('child_process');

const pkg = `@lapius/why-${process.platform}-${process.arch}`;
let bin;
try {
  bin = require.resolve(`${pkg}/bin/why`);
} catch {
  console.error(`why: ${pkg} が見つかりません（未対応の環境か、optionalDependencies が省略されました）`);
  console.error('  npm i -g @lapius/why で入れ直してください');
  process.exit(1);
}

// 記録ファイルはシェルの PID で探すため、node ではなくシェルの PID を渡す
const r = spawnSync(bin, process.argv.slice(2), {
  stdio: 'inherit',
  env: { ...process.env, WHY_PPID: String(process.ppid) },
});
if (r.error) {
  console.error(`why: ${bin} を起動できません: ${r.error.message}`);
  process.exit(1);
}
if (r.signal) process.kill(process.pid, r.signal);
process.exit(r.status ?? 1);
